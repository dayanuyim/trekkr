{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": "./app",
        "sourceMap": true,
        "module": "CommonJS",
        //"module": "NodeNext",
        //"moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "target": "ES6",
        //"target": "ESNext",
        "lib": [
            "DOM",
            "ES2019",
            "ESNext",
        ],
        //"downlevelIteration": true,
        "allowJs": true,
        "alwaysStrict": true,
        "noImplicitAny": false,                 // TODO: fix this
        "noImplicitThis": false,                // TODO: fix this
        "strictPropertyInitialization": false,  // TODO: fix this
        "strictNullChecks": false,
    },
    "include": [
        "app/**/*",
    ]
}

{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": "./app",
        "sourceMap": true,
        //"module": "CommonJS",
        "module": "ESNext",   //支援動態載入 module
        "esModuleInterop": true,
        "target": "ES6",
        "lib": [
            "DOM",
            "ES2019",
            "ESNext"
        ],
        "allowJs": true,
        "noImplicitAny": false,                 // TODO: fix this
        "noImplicitThis": false,                // TODO: fix this
        "strictPropertyInitialization": false,  // TODO: fix this
        "strictNullChecks": false,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "types": [
            "google.maps"
        ]
    },
    "include": [
        "app/**/*"
    ]
}

{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": "./app",
        "sourceMap": true,
        "module": "CommonJS",
        "esModuleInterop": true,
        "target": "ES6",
        "lib": [
            "DOM",
            "ES2019"
